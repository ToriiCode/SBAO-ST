<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <!-- Aquí mostraremos el nombre que vino de la pantalla anterior -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hola, Usuario"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:textColor="#333333"/>

    <Button
        android:id="@+id/btnVercel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 Abrir Proyecto en Vercel"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnInstagram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📸 Visitar nuestro Instagram"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnLlamar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 Llamar al Equipo"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✉️ Enviar Correo de Contacto"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Ver Sede en el Mapa" />

</LinearLayout>